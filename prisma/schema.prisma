generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  name      String
  username  String    @unique  // <-- PASTIKAN INI 'username', BUKAN 'email'
  password  String    @default("123456")
  role      String    @default("PEGAWAI")
  laporan   Laporan[]
}
model Laporan {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  judul        String
  tanggalDinas DateTime
  fileUrl      String
  status       String   @default("TEPAT_WAKTU")
  createdAt    DateTime @default(now())
}